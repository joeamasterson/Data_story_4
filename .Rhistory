library(knitr)
econ %>%
filter(year == 2020) %>%
group_by(source) %>%
summarize(cost = mean(cost, na.rm = TRUE)) %>%
arrange(cost) %>%
mutate(cost = dollar(cost, accuracy = 0.001)) %>%
kable(
col.names = c("Energy Source", "Average LCOE ($/kWh)"),
caption = "Table 1. Average Levelized Cost of Energy by Source (2020)"
) %>%
kable_styling(
full_width = FALSE,
position = "center",
bootstrap_options = c("striped", "hover")
)
