library(dplyr)
library(readr)
library(ggplot2)
url <- 'https://nyc3.digitaloceanspaces.com/owid-public/data/co2/owid-co2-data.csv'
carbon <-
read.csv(url) %>%
select(country,
year,
pop = population,
gdp,
co2,
hist_co2 = cumulative_co2)
carbon %>% pull(country) %>% unique %>% sort
View(carbon)
countries_use<- carbon %>% filter(country %in% c("United States", "China", "India", "Mexico", "Brazil"))
View(countries_use)
carbi <-
carbon %>%
filter(country %in% countries_use)
View(carbi)
View(carbi)
View(carbi)
geom_path() +
labs(title = 'Annual emissions by country',
subtitle = 'CO2 is in millions of metric tons') +
theme_light()
ggplot(countries_use,aes(x=year,
y=co2,
color=country)) +
geom_path() +
labs(title = 'Annual emissions by country',
subtitle = 'CO2 is in millions of metric tons') +
theme_light()
ggplot(countries_use,
aes(x=year,
y=hist_co2,
color=country)) +
geom_path() +
labs(title = 'Cumulative emissions by country',
subtitle = 'CO2 is in millions of metric tons') +
theme_light()
countries_used_carbon<-
countries_use %>%
mutate(co2 = co2 * 1000000) %>%
mutate(co2_per_capita = co2 / pop)
ggplot(countries_used_carbon,
aes(x=year,
y=co2_per_capita,
color=country)) +
geom_path() +
labs(title = 'CO2 per capita')
#Table
carbon_table <-
countries_used_carbon %>%
group_by(country) %>%
summarize(mean_co2 = mean(co2, na.rm=TRUE)) %>%
arrange(desc(mean_co2))
View(carbon_table)
ggplot(countries_use,
aes(x = year, y = co2)) +
geom_line(color = "steelblue", linewidth = 1) +
facet_wrap(~ country, scales = "free_y") +
labs(
title = "Annual CO₂ emissions by country",
subtitle = "Same story, different scales",
x = "Year",
y = "CO₂ (million metric tons)"
) +
theme_light()
